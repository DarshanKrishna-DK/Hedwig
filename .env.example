# Hedera account ID, e.g. 0.0.12345
# Create one for free at https://portal.hedera.com (testnet grants 1000 HBAR)
HEDERA_ACCOUNT_ID=

# Private key associated with the account above.
# Accepts either ECDSA (MetaMask-compatible) or ED25519 keys, hex or DER encoded.
HEDERA_PRIVATE_KEY=

# Hedera network. Use hedera-testnet for the bounty demo.
NETWORK=hedera-testnet

# Per-call USDC ceiling. The wallet refuses to sign anything above this.
MAX_PER_CALL=0.10

# Per-day USDC ceiling (UTC).
MAX_PER_DAY=20.00
